{%- extends "layout" -%}

{% block title %}Payments - Accounting{% endblock %}

{% block content %}
{% import "_macros/csrf" as csrf %}
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="mb-0">Payments</h1>
        <p class="text-muted">All client payments recorded.</p>
    </div>
    {% if canCreate %}
    <a href="/accounting/payments/new" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Record Payment
    </a>
    {% endif %}
</div>

<div class="card bg-dark border-secondary mt-3">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-dark table-striped data-table" id="paymentsTable">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Date</th>
                        <th>Client</th>
                        <th>Category</th>
                        <th>Method</th>
                        <th>Received By</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    {% for p in payments %}
                    <tr>
                        <td>{{ p.code }}</td>
                        <td>{{ p.paymentDate }}</td>
                        <td>{{ p.clientName | default("N/A") }}</td>
                        <td>{{ p.category }}</td>
                        <td>{{ p.paymentMethod }}</td>
                        <td>{{ p.receivedBy }}</td>
                        <td class="text-end">$ {{ p.amount }}</td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No payments recorded yet.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script nonce="{{ securityNonce }}">
document.addEventListener('DOMContentLoaded', function() {
    if (typeof $.fn.DataTable !== 'undefined') {
        $('#paymentsTable').DataTable({
            pageLength: 10,
            order: [[1, 'desc']],
            language: {
                search: 'Search:',
                lengthMenu: 'Show _MENU_ entries'
            }
        });
    }
});
</script>
{% endblock %}
