<?xml version="1.0" encoding="UTF-8"?>
<!-- books-domain: pure business rules with zero framework dependencies. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.library</groupId>
        <artifactId>books</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>books-domain</artifactId>
    <name>Books Domain</name>
    <description>
        Pure domain layer of the Books feature. Contains the domain models
        (Work, Edition, Author, Publisher, Language, BookFormat, Category)
        and the ports that define the contracts of the feature. This module
        has NO framework or infrastructure dependency: it only uses the JDK.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
