{%- extends "layout" -%}

{% block title %}Audit Detail - Library{% endblock %}

{% block content %}
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="mb-0">Audit Detail</h1>
        <p class="text-muted">{{ entityClass }} #{{ entityId }} at revision #{{ entry.revision }}</p>
    </div>
    <a href="/books/audit/revisions?entityClass={{ entityClass }}&entityId={{ entityId }}" class="btn btn-outline-secondary">
        Back to revisions
    </a>
</div>

{% if error %}
<div class="alert alert-danger">{{ error }}</div>
{% endif %}

{% if entry %}
<div class="mt-3">
    <div class="card bg-dark border-secondary">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <p class="text-muted mb-1">Revision</p>
                    <p class="mb-0">#{{ entry.revision }}</p>
                </div>
                <div class="col-md-6">
                    <p class="text-muted mb-1">Timestamp</p>
                    <p class="mb-0">{{ entry.revisionTimestamp | date("Y-MM-dd HH:mm:ss") }}</p>
                </div>
                <div class="col-md-6">
                    <p class="text-muted mb-1">User</p>
                    <p class="mb-0">{{ entry.username }}</p>
                </div>
                <div class="col-md-6">
                    <p class="text-muted mb-1">Type</p>
                    <p class="mb-0">
                        {% if entry.revisionType == 0 %}ADD
                        {% elseif entry.revisionType == 1 %}MOD
                        {% elseif entry.revisionType == 2 %}DEL
                        {% else %}UNKNOWN{% endif %}
                    </p>
                </div>
                <div class="col-12">
                    <p class="text-muted mb-1">Entity Data</p>
                    <pre class="bg-dark border border-secondary rounded p-3 text-light">{{ entry.entity }}</pre>
                </div>
            </div>
        </div>
    </div>
</div>
{% else %}
<div class="alert alert-warning">No entity data available for this revision.</div>
{% endif %}
{% endblock %}
