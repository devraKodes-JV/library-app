{%- extends "layout" -%}
{% import "_macros/csrf" as csrf %}

{% block title %}Author Roles - Library{% endblock %}

{% block content %}
<div class="page-header">
    <h1 class="mb-0">Author Roles</h1>
    <p class="text-muted">Manage the roles that authors can have in works and editions.</p>
</div>

<div class="card mt-3 bg-dark border-secondary">
    <div class="card-body bg-dark">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="input-group w-auto">
                <input type="text" id="searchInput" class="form-control bg-dark border-secondary text-light" placeholder="Search roles...">
                <button class="btn btn-outline-secondary" type="button">
                    <i class="bi bi-search"></i>
                </button>
            </div>
            {% if canCreate %}
            <a href="/books/authorRoles/new" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> New Role
            </a>
            {% endif %}
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 data-table text-light">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for authorRole in authorRoles %}
                    <tr>
                        <td>{{ authorRole.code }}</td>
                        <td>{{ authorRole.name }}</td>
                        <td class="text-muted">{{ authorRole.description | default("N/A") }}</td>
                        <td class="text-end">
                            {% if canUpdate %}
                            <a href="/books/authorRoles/{{ authorRole.id }}/edit" class="btn btn-sm btn-outline-primary" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            {% endif %}
                            {% if canDelete %}
                            <form method="post" action="/books/authorRoles/{{ authorRole.id }}/delete" class="d-inline" data-confirm-title="Confirm" data-confirm-message="Are you sure you want to delete this author role?">
                                {{ csrf.token(csrfToken) }}
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                            {% endif %}
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">No author roles found.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<script nonce="{{ securityNonce }}">
document.addEventListener('DOMContentLoaded', function() {
    var searchInput = document.getElementById('searchInput');
    if (searchInput) {
        searchInput.addEventListener('keyup', function() {
            var value = this.value.toLowerCase();
            var rows = document.querySelectorAll('tbody tr');
            rows.forEach(function(row) {
                var text = row.innerText.toLowerCase();
                if (text.includes(value)) {
                    row.classList.remove('hidden-row');
                } else {
                    row.classList.add('hidden-row');
                }
            });
        });
    }

    if (typeof $.fn.DataTable !== 'undefined') {
        $('.data-table').DataTable({
            pageLength: 10,
            order: [[0, 'asc']],
            language: {
                search: 'Search:',
                lengthMenu: 'Show _MENU_ entries'
            }
        });
    }
});
</script>
<style nonce="{{ securityNonce }}">
.hidden-row { display: none; }
</style>
{% endblock %}
