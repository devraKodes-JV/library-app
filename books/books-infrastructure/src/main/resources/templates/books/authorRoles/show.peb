{%- extends "layout" -%}

{% block title %}{{ authorRole.name }} - Library{% endblock %}

{% block content %}
<div class="page-header">
    <h1 class="mb-0">{{ authorRole.name }}</h1>
    <p class="text-muted">Author role details.</p>
</div>

<div class="card mt-3 bg-dark border-secondary">
    <div class="card-body bg-dark">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Code</label>
                <input type="text" class="form-control bg-dark border-secondary text-light" value="{{ authorRole.code }}" readonly>
            </div>
            <div class="col-md-6">
                <label class="form-label">Name</label>
                <input type="text" class="form-control bg-dark border-secondary text-light" value="{{ authorRole.name }}" readonly>
            </div>
        </div>
        <div class="row g-3 mt-0">
            <div class="col-12">
                <label class="form-label">Description</label>
                <textarea class="form-control bg-dark border-secondary text-light" rows="2" readonly>{% if authorRole.description is not empty %}{{ authorRole.description }}{% endif %}</textarea>
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    {% if canUpdate %}
    <a href="/books/authorRoles/{{ authorRole.id }}/edit" class="btn btn-primary">
        <i class="bi bi-pencil"></i> Edit
    </a>
    {% endif %}
    {% if canDelete %}
    <form method="post" action="/books/authorRoles/{{ authorRole.id }}/delete" class="d-inline" data-confirm-title="Confirm" data-confirm-message="Are you sure you want to delete this author role?">
        {% import "_macros/csrf" as csrf %}
        {{ csrf.token(csrfToken) }}
        <button type="submit" class="btn btn-outline-danger">
            <i class="bi bi-trash"></i> Delete
        </button>
    </form>
    {% endif %}
    <a href="/books/authorRoles" class="btn btn-outline-secondary">Back to list</a>
</div>
{% endblock %}
