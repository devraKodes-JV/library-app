{%- extends "layout" -%}

{% block title %}{% if mode == 'edit' %}Edit Author{% else %}New Author{% endif %} - Library{% endblock %}

{% block content %}
<div class="page-header">
    <h1 class="mb-0">
        {% if mode == 'edit' %}Edit Author{% else %}New Author{% endif %}
    </h1>
    <p class="text-muted">Author information.</p>
</div>

<form method="post"
      action="{% if mode == 'edit' %}/books/authors/{{ author.id }}{% else %}/books/authors{% endif %}"
      class="text-light" novalidate>
    {% import "_macros/csrf" as csrf %}
    {{ csrf.token(csrfToken) }}
    <div class="card mt-3 bg-dark border-secondary">
        <div class="card-body bg-dark">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="firstName">First Name</label>
                    <input type="text" id="firstName" name="firstName" class="form-control bg-dark border-secondary text-light {% if firstName is defined and firstName %}is-invalid{% else %}{% if author is not null %}is-valid{% endif %}{% endif %}" required
                           value="{% if author is not null %}{{ author.firstName }}{% endif %}">
                    <div class="invalid-feedback" id="firstNameError">{% if firstName is defined and firstName %}{{ firstName }}{% endif %}</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="lastName">Last Name</label>
                    <input type="text" id="lastName" name="lastName" class="form-control bg-dark border-secondary text-light {% if lastName is defined and lastName %}is-invalid{% else %}{% if author is not null %}is-valid{% endif %}{% endif %}" required
                           value="{% if author is not null %}{{ author.lastName }}{% endif %}">
                    <div class="invalid-feedback" id="lastNameError">{% if lastName is defined and lastName %}{{ lastName }}{% endif %}</div>
                </div>
            </div>
            <div class="row g-3 mt-0">
                <div class="col-md-6">
                    <label class="form-label" for="birthDate">Birth Date</label>
                    <input type="date" id="birthDate" name="birthDate" class="form-control bg-dark border-secondary text-light {% if birthDate is defined and birthDate %}is-invalid{% else %}{% if author is not null and author.birthDate is not empty %}is-valid{% endif %}{% endif %}"
                           value="{% if author is not null %}{{ author.birthDate }}{% endif %}" max="2000-01-01">
                    <div class="invalid-feedback" id="birthDateError">{% if birthDate is defined and birthDate %}{{ birthDate }}{% endif %}</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="deathDate">Death Date</label>
                    <input type="date" id="deathDate" name="deathDate" class="form-control bg-dark border-secondary text-light {% if deathDate is defined and deathDate %}is-invalid{% else %}{% if author is not null and author.deathDate is not empty %}is-valid{% endif %}{% endif %}"
                           value="{% if author is not null %}{{ author.deathDate }}{% endif %}">
                    <div class="invalid-feedback" id="deathDateError">{% if deathDate is defined and deathDate %}{{ deathDate }}{% endif %}</div>
                </div>
            </div>
            <div class="row g-3 mt-0">
                <div class="col-12">
                    <label class="form-label" for="biography">Biography</label>
                    <textarea id="biography" name="biography" rows="3" class="form-control bg-dark border-secondary text-light {% if biography is defined and biography %}is-invalid{% else %}{% if author is not null and author.biography is not empty %}is-valid{% endif %}{% endif %}">{% if author is not null %}{{ author.biography }}{% endif %}</textarea>
                    <div class="invalid-feedback" id="biographyError">{% if biography is defined and biography %}{{ biography }}{% endif %}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" id="submitBtn" class="btn btn-primary" disabled>
            <i class="bi bi-check-lg"></i> Save
        </button>
        <a href="/books/authors" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

<script nonce="{{ securityNonce }}">
document.addEventListener('DOMContentLoaded', function() {
    var form = document.querySelector('form[novalidate]');
    if (!form) return;
    
    var birthDateInput = document.getElementById('birthDate');
    if (birthDateInput) {
        var today = new Date();
        var maxBirth = new Date(today.getFullYear() - 18, today.getMonth(), today.getDate());
        birthDateInput.max = maxBirth.toISOString().split('T')[0];
    }
    
    var submitBtn = document.getElementById('submitBtn');
    var fields = ['firstName', 'lastName', 'birthDate', 'deathDate', 'biography'];
    var fieldErrors = {
        firstName: document.getElementById('firstNameError'),
        lastName: document.getElementById('lastNameError'),
        birthDate: document.getElementById('birthDateError'),
        deathDate: document.getElementById('deathDateError'),
        biography: document.getElementById('biographyError')
    };
    var birthDate = document.getElementById('birthDate');
    var alphaRegex = /^[a-zA-ZÀ-ÿ\s'-]+$/;
    var dateRegex = /^\d{4}-\d{2}-\d{2}$/;
    
    function isFirstNameValid() {
        var value = firstName.value.trim();
        if (!value) return false;
        if (!alphaRegex.test(value)) return false;
        return true;
    }
    
    function isLastNameValid() {
        var value = lastName.value.trim();
        if (!value) return false;
        if (!alphaRegex.test(value)) return false;
        return true;
    }
    
    function isBirthDateValid() {
        var value = birthDate.value.trim();
        if (!value) return false;
        if (!dateRegex.test(value)) return false;
        var today = new Date();
        var birth = new Date(value);
        var minBirth = new Date(today.getFullYear() - 18, today.getMonth(), today.getDate());
        if (birth > minBirth) return false;
        if (birth > today) return false;
        return true;
    }
    
    function isDeathDateValid() {
        var value = deathDate.value.trim();
        if (!value) return true;
        if (!dateRegex.test(value)) return false;
        if (value) {
            var today2 = new Date();
            today2.setHours(0,0,0,0);
            var death = new Date(value);
            if (death > today2) return false;
            if (birthDate.value.trim() && dateRegex.test(birthDate.value.trim())) {
                var birth = new Date(birthDate.value.trim());
                if (death < birth) return false;
            }
        }
        return true;
    }
    
    function isBiographyValid() {
        var value = biography.value.trim();
        if (value && value.length > 2000) return false;
        if (value && !/^[a-zA-ZÀ-ÿ0-9\s.,!?'"'-]*$/.test(value)) return false;
        return true;
    }
    
    function validateField(fieldName) {
        var el = document.getElementById(fieldName);
        var errorEl = fieldErrors[fieldName];
        var value = el.value.trim();
        var valid = true;
        
        if (fieldName === 'firstName') {
            valid = isFirstNameValid();
            if (!valid) {
                errorEl.textContent = value ? 'First name must contain only letters, spaces, hyphens or apostrophes.' : 'First name is required.';
            } else {
                errorEl.textContent = '';
            }
        } else if (fieldName === 'lastName') {
            valid = isLastNameValid();
            if (!valid) {
                errorEl.textContent = value ? 'Last name must contain only letters, spaces, hyphens or apostrophes.' : 'Last name is required.';
            } else {
                errorEl.textContent = '';
            }
        } else if (fieldName === 'birthDate') {
            valid = isBirthDateValid();
            if (!valid) {
                if (!value) {
                    errorEl.textContent = 'Birth date is required.';
                } else if (!dateRegex.test(value)) {
                    errorEl.textContent = 'Invalid birth date format. Use YYYY-MM-DD.';
                } else {
                    var today = new Date();
                    var birth = new Date(value);
                    var minBirth = new Date(today.getFullYear() - 18, today.getMonth(), today.getDate());
                    if (birth > minBirth) {
                        errorEl.textContent = 'Author must be at least 18 years old.';
                    } else if (birth > today) {
                        errorEl.textContent = 'Birth date cannot be in the future.';
                    }
                }
            } else {
                errorEl.textContent = '';
            }
        } else if (fieldName === 'deathDate') {
            valid = isDeathDateValid();
            if (!valid) {
                if (!dateRegex.test(value)) {
                    errorEl.textContent = 'Invalid death date format. Use YYYY-MM-DD.';
                } else {
                    var today2 = new Date();
                    today2.setHours(0,0,0,0);
                    var death = new Date(value);
                    if (death > today2) {
                        errorEl.textContent = 'Death date cannot be in the future.';
                    } else if (birthDate.value.trim() && dateRegex.test(birthDate.value.trim())) {
                        var birth = new Date(birthDate.value.trim());
                        if (death < birth) {
                            errorEl.textContent = 'Death date cannot be before birth date.';
                        }
                    }
                }
            } else {
                errorEl.textContent = '';
            }
        } else if (fieldName === 'biography') {
            valid = isBiographyValid();
            if (!valid) {
                if (value && value.length > 2000) {
                    errorEl.textContent = 'Biography must be 2000 characters or less.';
                } else if (value && !/^[a-zA-ZÀ-ÿ0-9\s.,!?'"'-]*$/.test(value)) {
                    errorEl.textContent = 'Biography contains invalid characters.';
                }
            } else {
                errorEl.textContent = '';
            }
        }
        
        if (valid && value) {
            el.classList.remove('is-invalid');
            el.classList.add('is-valid');
        } else if (!valid) {
            el.classList.add('is-invalid');
            el.classList.remove('is-valid');
        } else {
            el.classList.remove('is-invalid');
            el.classList.remove('is-valid');
        }
        
        return valid;
    }
    
    function updateSubmitButton() {
        var valid = isFirstNameValid() && isLastNameValid() && isBirthDateValid() && isDeathDateValid() && isBiographyValid();
        submitBtn.disabled = !valid;
        return valid;
    }
    
    fields.forEach(function(fieldName) {
        var el = document.getElementById(fieldName);
        if (!el) return;
        el.addEventListener('input', function() {
            validateField(fieldName);
            updateSubmitButton();
        });
        el.addEventListener('change', function() {
            validateField(fieldName);
            updateSubmitButton();
        });
        el.addEventListener('blur', function() {
            validateField(fieldName);
            updateSubmitButton();
        });
    });
    
    form.addEventListener('submit', function(e) {
        if (!updateSubmitButton()) {
            e.preventDefault();
        }
    });
});
</script>
{% endblock %}
