{%- extends "layout" -%}

{% block title %}Author Details - Library{% endblock %}

{% block breadcrumb %}
{% set breadcrumbItems = [
    {'label': 'Authors', 'url': '/books/authors'},
    {'label': author.firstName ~ ' ' ~ author.lastName, 'url': null}
] %}
{{ parent() }}
{% endblock %}

{% block content %}
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="mb-0">{{ author.firstName }} {{ author.lastName }}</h1>
    </div>
    <div class="d-flex gap-2">
        {% if canUpdate %}
        <a href="/books/authors/{{ author.id }}/edit" class="btn btn-outline-secondary" aria-label="Edit {{ author.firstName }} {{ author.lastName }}">
            <i class="bi bi-pencil"></i> Edit
        </a>
        {% endif %}
        {% if canDelete %}
        <form method="post" action="/books/authors/{{ author.id }}/delete" class="d-inline delete-form"
              data-confirm-title="Delete Author"
              data-confirm-message="Delete author <strong>{{ author.firstName }} {{ author.lastName }}</strong>? This action can be undone.">
            {{ csrf.token(csrfToken) }}
            <button type="submit" class="btn btn-outline-danger" aria-label="Delete {{ author.firstName }} {{ author.lastName }}">
                <i class="bi bi-trash"></i> Delete
            </button>
        </form>
        {% endif %}
    </div>
</div>

<div class="card mt-3 bg-dark border-secondary">
    <div class="card-header bg-dark border-secondary">
        <h5 class="mb-0">Author Information</h5>
    </div>
    <div class="card-body bg-dark">
        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted">First Name</dt>
            <dd class="col-sm-9">{{ author.firstName }}</dd>

            <dt class="col-sm-3 text-muted">Last Name</dt>
            <dd class="col-sm-9">{{ author.lastName }}</dd>

            {% if author.birthDate is not empty %}
            <dt class="col-sm-3 text-muted">Birth Date</dt>
            <dd class="col-sm-9">{{ author.birthDate }}</dd>
            {% endif %}

            {% if author.deathDate is not empty %}
            <dt class="col-sm-3 text-muted">Death Date</dt>
            <dd class="col-sm-9">{{ author.deathDate }}</dd>
            {% endif %}

            {% if author.biography is not empty %}
            <dt class="col-sm-3 text-muted">Biography</dt>
            <dd class="col-sm-9">{{ author.biography }}</dd>
            {% endif %}
        </dl>
    </div>
</div>

<div class="mt-3">
    <a href="/books/authors" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to Authors
    </a>
</div>

<div class="card mt-4 bg-dark border-secondary">
    <div class="card-header bg-dark border-secondary">
        <h5 class="mb-0">Related Works</h5>
    </div>
    <div class="card-body bg-dark p-0">
        <div class="table-responsive container">
            <table class="table table-hover align-middle mb-0 data-table text-light" data-empty-message="No works associated with this author yet.">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Language</th>
                        <th>Category</th>
                    </tr>
                </thead>
                <tbody>
                    {% for work in relatedWorks %}
                    <tr>
                        <td>
                            <a href="/books/works/{{ work.id }}" class="text-decoration-none text-light">
                                {{ work.title }}
                            </a>
                        </td>
                         <td class="text-muted">{{ work.languageName | default("N/A") }}</td>
                        <td class="text-muted">{{ work.categoryName | default("N/A") }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/js/books.js" nonce="{{ securityNonce }}"></script>
{% endblock %}
