{%- extends "layout" -%}

{% block title %}Format Details - Library{% endblock %}

{% block breadcrumb %}
{% set breadcrumbItems = [
    {'label': 'Formats', 'url': '/books/formats'},
    {'label': format.name, 'url': null}
] %}
{{ parent() }}
{% endblock %}

{% block content %}
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="mb-0">{{ format.name }}</h1>
        <p class="text-muted">Code: {{ format.code }}</p>
    </div>
    <div class="d-flex gap-2">
        {% if canUpdate %}
        <a href="/books/formats/{{ format.id }}/edit" class="btn btn-outline-secondary" aria-label="Edit {{ format.name }}">
            <i class="bi bi-pencil"></i> Edit
        </a>
        {% endif %}
        {% if canDelete %}
        <form method="post" action="/books/formats/{{ format.id }}/delete" class="d-inline delete-form"
              data-confirm-title="Delete Format"
              data-confirm-message="Delete format <strong>{{ format.name }}</strong>? This action can be undone.">
            {{ csrf.token(csrfToken) }}
            <button type="submit" class="btn btn-outline-danger" aria-label="Delete {{ format.name }}">
                <i class="bi bi-trash"></i> Delete
            </button>
        </form>
        {% endif %}
    </div>
</div>

<div class="card mt-3 bg-dark border-secondary">
    <div class="card-header bg-dark border-secondary">
        <h5 class="mb-0">Format Information</h5>
    </div>
    <div class="card-body bg-dark">
        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted">Code</dt>
            <dd class="col-sm-9">{{ format.code }}</dd>

            <dt class="col-sm-3 text-muted">Name</dt>
            <dd class="col-sm-9">{{ format.name }}</dd>

            {% if format.description is not empty %}
            <dt class="col-sm-3 text-muted">Description</dt>
            <dd class="col-sm-9">{{ format.description }}</dd>
            {% endif %}
        </dl>
    </div>
</div>

<div class="mt-3">
    <a href="/books/formats" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to Formats
    </a>
</div>

<div class="card mt-4 bg-dark border-secondary">
    <div class="card-header bg-dark border-secondary">
        <h5 class="mb-0">Related Editions</h5>
    </div>
    <div class="card-body bg-dark p-0">
        <div class="table-responsive container">
            <table class="table table-hover align-middle mb-0 data-table text-light" data-empty-message="No editions associated with this format yet.">
                <thead>
                    <tr>
                        <th>Edition</th>
                        <th>Work</th>
                        <th>Publisher</th>
                        <th>Language</th>
                        <th>ISBN</th>
                        <th>Year</th>
                    </tr>
                </thead>
                <tbody>
                    {% for edition in relatedEditions %}
                    <tr>
                        <td>
                            <a href="/books/editions/{{ edition.id }}" class="text-decoration-none text-light">
                                {{ edition.editionNumber }}
                            </a>
                        </td>
                        <td class="text-muted">{{ edition.workTitle | default("N/A") }}</td>
                        <td class="text-muted">{{ edition.publisherName | default("N/A") }}</td>
                        <td class="text-muted">{{ edition.languageName | default("N/A") }}</td>
                        <td class="text-muted">{{ edition.isbn | default("N/A") }}</td>
                        <td class="text-muted">{{ edition.publicationYear | default("N/A") }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/js/books.js" nonce="{{ securityNonce }}"></script>
{% endblock %}
