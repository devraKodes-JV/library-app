{%- extends "layout" -%}

{% block title %}Languages - Library{% endblock %}

{% block content %}
{% import "_macros/csrf" as csrf %}
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="mb-0">Languages</h1>
        <p class="text-muted">Manage languages.</p>
    </div>
    {% if canCreate %}
    <a href="/books/languages/new" class="btn btn-primary text-white">
        <i class="bi bi-plus-lg"></i> New Language
    </a>
    {% endif %}
</div>

{% if languages is empty %}
<div class="alert alert-info bg-dark border-secondary text-light">No languages found.</div>
{% else %}
<div class="card mt-3 bg-dark border-secondary">
    <div class="table-responsive container">
        <table class="table table-hover align-middle mb-0 data-table text-light">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for lang in languages %}
                <tr>
                    <td>
                        <span class="badge bg-primary">{{ lang.code }}</span>
                    </td>
                    <td>
                        <a href="/books/languages/{{ lang.id }}" class="text-decoration-none text-light">
                            {{ lang.name }}
                        </a>
                    </td>
                    <td class="text-end">
                        {% if canUpdate %}
                        <a href="/books/languages/{{ lang.id }}/edit" class="btn btn-sm btn-outline-secondary" aria-label="Edit {{ lang.name }}">
                            <i class="bi bi-pencil"></i>
                        </a>
                        {% endif %}
                        {% if canDelete %}
                        <form method="post" action="/books/languages/{{ lang.id }}/delete" class="d-inline delete-form"
                              data-confirm-title="Delete Language"
                              data-confirm-message="Delete language <strong>{{ lang.name }}</strong>? This action can be undone.">
                            {{ csrf.token(csrfToken) }}
                            <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Delete {{ lang.name }}">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}

{% endblock %}

{% block scripts %}
<script src="/js/iam.js" nonce="{{ securityNonce }}"></script>
<script src="/js/books.js" nonce="{{ securityNonce }}"></script>
{% endblock %}
