{%- extends "layout" -%}

{% block title %}Language Details - Library{% endblock %}

{% block breadcrumb %}
{% set breadcrumbItems = [
    {'label': 'Languages', 'url': '/books/languages'},
    {'label': language.name, 'url': null}
] %}
{{ parent() }}
{% endblock %}

{% block content %}
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="mb-0">{{ language.name }}</h1>
        <p class="text-muted">Code: {{ language.code }}</p>
    </div>
    <div class="d-flex gap-2">
        {% if canUpdate %}
        <a href="/books/languages/{{ language.id }}/edit" class="btn btn-outline-secondary" aria-label="Edit {{ language.name }}">
            <i class="bi bi-pencil"></i> Edit
        </a>
        {% endif %}
        {% if canDelete %}
        <form method="post" action="/books/languages/{{ language.id }}/delete" class="d-inline delete-form"
              data-confirm-title="Delete Language"
              data-confirm-message="Delete language <strong>{{ language.name }}</strong>? This action can be undone.">
            {{ csrf.token(csrfToken) }}
            <button type="submit" class="btn btn-outline-danger" aria-label="Delete {{ language.name }}">
                <i class="bi bi-trash"></i> Delete
            </button>
        </form>
        {% endif %}
    </div>
</div>

<div class="card mt-3 bg-dark border-secondary">
    <div class="card-header bg-dark border-secondary">
        <h5 class="mb-0">Language Information</h5>
    </div>
    <div class="card-body bg-dark">
        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted">Code</dt>
            <dd class="col-sm-9">{{ language.code }}</dd>

            <dt class="col-sm-3 text-muted">Name</dt>
            <dd class="col-sm-9">{{ language.name }}</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a href="/books/languages" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to Languages
    </a>
</div>

<div class="card mt-4 bg-dark border-secondary">
    <div class="card-header bg-dark border-secondary">
        <h5 class="mb-0">Related Works</h5>
    </div>
    <div class="card-body bg-dark p-0">
        <div class="table-responsive container">
            <table class="table table-hover align-middle mb-0 data-table text-light" data-empty-message="No works associated with this language yet.">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Language</th>
                        <th>Category</th>
                    </tr>
                </thead>
                <tbody>
                    {% for work in relatedWorks %}
                    <tr>
                        <td>
                            <a href="/books/works/{{ work.id }}" class="text-decoration-none text-light">
                                {{ work.title }}
                            </a>
                        </td>
                        <td class="text-muted">{{ work.originalLanguageName | default("N/A") }}</td>
                        <td class="text-muted">{{ work.categoryName | default("N/A") }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/js/books.js" nonce="{{ securityNonce }}"></script>
{% endblock %}
