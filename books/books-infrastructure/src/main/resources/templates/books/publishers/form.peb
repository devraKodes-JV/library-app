{%- extends "layout" -%}

{% block title %}{% if mode == 'edit' %}Edit Publisher{% else %}New Publisher{% endif %} - Library{% endblock %}

{% block content %}
<div class="page-header">
    <h1 class="mb-0">
        {% if mode == 'edit' %}Edit Publisher{% else %}New Publisher{% endif %}
    </h1>
    <p class="text-muted">Publisher information.</p>
</div>

<form method="post"
      action="{% if mode == 'edit' %}/books/publishers/{{ publisher.id }}{% else %}/books/publishers{% endif %}"
      class="text-light" novalidate>
    {% import "_macros/csrf" as csrf %}
    {{ csrf.token(csrfToken) }}
    <div class="card mt-3 bg-dark border-secondary">
        <div class="card-body bg-dark">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="name">Name</label>
                    <input type="text" id="name" name="name" class="form-control bg-dark border-secondary text-light {% if name is defined and name %}is-invalid{% else %}{% if publisher is not null %}is-valid{% endif %}{% endif %}" required
                           value="{% if publisher is not null %}{{ publisher.name }}{% endif %}">
                    {% if name is defined and name %}
                    <div class="invalid-feedback">{{ name }}</div>
                    {% endif %}
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="country">Country</label>
                    <input type="text" id="country" name="country" class="form-control bg-dark border-secondary text-light"
                           value="{% if publisher is not null %}{{ publisher.country }}{% endif %}">
                </div>
            </div>
            <div class="row g-3 mt-0">
                <div class="col-12">
                    <label class="form-label" for="website">Website</label>
                    <input type="text" id="website" name="website" class="form-control bg-dark border-secondary text-light {% if website is defined and website %}is-invalid{% else %}{% if publisher is not null and publisher.website is not empty %}is-valid{% endif %}{% endif %}"
                           value="{% if publisher is not null %}{{ publisher.website }}{% endif %}">
                    {% if website is defined and website %}
                    <div class="invalid-feedback">{{ website }}</div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg"></i> Save
        </button>
        <a href="/books/publishers" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var form = document.querySelector('form[novalidate]');
    if (!form) return;
    form.addEventListener('submit', function(e) {
        var valid = true;
        var name = document.getElementById('name');
        var alphaRegex = /^[a-zA-ZÀ-ÿ\s'-]+$/;
        
        if (!name.value.trim()) {
            name.classList.add('is-invalid');
            name.classList.remove('is-valid');
            valid = false;
        } else if (!alphaRegex.test(name.value.trim())) {
            name.classList.add('is-invalid');
            name.classList.remove('is-valid');
            valid = false;
        } else {
            name.classList.remove('is-invalid');
            name.classList.add('is-valid');
        }
        
        if (!valid) {
            e.preventDefault();
        }
    });
});
</script>
{% endblock %}
