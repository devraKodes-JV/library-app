{%- extends "layout" -%}

{% block title %}Publishers - Library{% endblock %}

{% block content %}
{% import "_macros/csrf" as csrf %}
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="mb-0">Publishers</h1>
        <p class="text-muted">Manage publishers.</p>
    </div>
    {% if canCreate %}
    <a href="/books/publishers/new" class="btn btn-primary text-white">
        <i class="bi bi-plus-lg"></i> New Publisher
    </a>
    {% endif %}
</div>

{% if publishers is empty %}
<div class="alert alert-info bg-dark border-secondary text-light">No publishers found.</div>
{% else %}
<div class="card mt-3 bg-dark border-secondary">
    <div class="table-responsive container">
        <table class="table table-hover align-middle mb-0 data-table text-light">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Country</th>
                    <th>Website</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for pub in publishers %}
                <tr>
                    <td>
                        <a href="/books/publishers/{{ pub.id }}" class="text-decoration-none text-light">
                            {{ pub.name }}
                        </a>
                    </td>
                    <td class="text-muted">{{ pub.country | default("N/A") }}</td>
                    <td class="text-muted">
                        {% if pub.website is not empty %}
                        <a href="{{ pub.website }}" target="_blank" rel="noopener noreferrer" class="text-decoration-none">
                            {{ pub.website }}
                        </a>
                        {% else %}
                        N/A
                        {% endif %}
                    </td>
                    <td class="text-end">
                        {% if canUpdate %}
                        <a href="/books/publishers/{{ pub.id }}/edit" class="btn btn-sm btn-outline-secondary" aria-label="Edit {{ pub.name }}">
                            <i class="bi bi-pencil"></i>
                        </a>
                        {% endif %}
                        {% if canDelete %}
                        <form method="post" action="/books/publishers/{{ pub.id }}/delete" class="d-inline delete-form"
                              data-confirm-title="Delete Publisher"
                              data-confirm-message="Delete publisher <strong>{{ pub.name }}</strong>? This action can be undone.">
                            {{ csrf.token(csrfToken) }}
                            <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Delete {{ pub.name }}">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}

{% endblock %}

{% block scripts %}
<script src="/js/iam.js" nonce="{{ securityNonce }}"></script>
<script src="/js/books.js" nonce="{{ securityNonce }}"></script>
{% endblock %}
