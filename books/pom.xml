<?xml version="1.0" encoding="UTF-8"?>
<!-- books feature aggregator POM (no source code, groups the hex layers). -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.library</groupId>
        <artifactId>library-ultimate</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>books</artifactId>
    <packaging>pom</packaging>
    <name>Books Feature</name>
    <description>
        Books feature. Aggregator POM that groups the three hexagonal layers
        as separate Maven modules: books-domain, books-application and
        books-infrastructure.
    </description>

    <modules>
        <module>books-domain</module>
        <module>books-application</module>
        <module>books-infrastructure</module>
    </modules>
</project>
