{%- extends "layout" -%}

{% block title %}Library Catalog{% endblock %}

{% block content %}
<div class="container py-4">
    <div class="d-flex align-items-center mb-4">
        <a href="/" class="btn btn-sm btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i> Back</a>
        <h1 class="h3 fw-bold text-light mb-0"><i class="bi bi-book"></i> Book Catalog</h1>
    </div>
    <p class="text-muted mb-4">Browse available books and make a reservation.</p>

    {% if catalogItems is empty %}
    <div class="alert alert-info bg-dark border-secondary text-light">
        <i class="bi bi-info-circle"></i> No books available at the moment.
    </div>
    {% else %}
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        {% for item in catalogItems %}
        <div class="col">
            <div class="card bg-dark border-secondary h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title text-light">{{ item.title }}</h5>
                    <p class="card-text text-muted small mb-2">
                        <i class="bi bi-bookmark"></i> Edition: {{ item.editionNumber }}
                    </p>
                    {% if item.publisher %}
                    <p class="card-text text-muted small mb-3">
                        <i class="bi bi-building"></i> Publisher: {{ item.publisher }}
                    </p>
                    {% endif %}
                    <div class="mt-auto d-flex justify-content-between align-items-center pt-2">
                        <span class="badge bg-success bg-opacity-25 text-success small">
                            <i class="bi bi-check-circle"></i> {{ item.available }} available
                        </span>
                        <a href="/catalog/reserve/{{ item.id }}" class="btn btn-sm btn-primary">
                            <i class="bi bi-calendar-check"></i> Reserve
                        </a>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}
</div>
{% endblock %}
