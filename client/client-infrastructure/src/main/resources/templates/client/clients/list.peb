{%- extends "layout" -%}

{% block title %}Clients - Library{% endblock %}

{% block content %}
{% import "_macros/csrf" as csrf %}
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="mb-0">Clients</h1>
        <p class="text-muted">Manage library clients and members.</p>
    </div>
    {% if canCreate %}
    <a href="/clients/new" class="btn btn-primary text-white">
        <i class="bi bi-plus-lg"></i> New Client
    </a>
    {% endif %}
</div>

<div class="d-flex gap-2 mb-3">
    <a href="?status=active" class="btn btn-sm {% if status == 'active' %}btn-primary{% else %}btn-outline-secondary{% endif %}">Active</a>
    <a href="?status=inactive" class="btn btn-sm {% if status == 'inactive' %}btn-primary{% else %}btn-outline-secondary{% endif %}">Inactive</a>
    <a href="?status=all" class="btn btn-sm {% if status == 'all' %}btn-primary{% else %}btn-outline-secondary{% endif %}">All</a>
</div>

{% if clients is empty %}
<div class="alert alert-info bg-dark border-secondary text-light">No clients found.</div>
{% else %}
<div class="card mt-3 bg-dark border-secondary">
    <div class="table-responsive container">
        <table class="table table-hover align-middle mb-0 data-table text-light">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>DNI</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for client in clients %}
                <tr>
                    <td><strong>{{ client.code }}</strong></td>
                    <td>{{ client.dni }}</td>
                    <td>{{ client.fullName }}</td>
                    <td class="text-muted">{{ client.email }}</td>
                    <td>
                        <span class="badge {% if client.type == 'MEMBER' %}bg-info{% else %}bg-secondary{% endif %}">
                            {{ client.typeLabel }}
                        </span>
                    </td>
                    <td>{{ client.status }}</td>
                    <td class="text-end">
                        <a href="/clients/{{ client.id }}" class="btn btn-sm btn-outline-secondary" aria-label="View {{ client.code }}">
                            <i class="bi bi-eye"></i>
                        </a>
                        {% if canUpdate and status != 'inactive' %}
                        <a href="/clients/{{ client.id }}/edit" class="btn btn-sm btn-outline-secondary" aria-label="Edit {{ client.code }}">
                            <i class="bi bi-pencil"></i>
                        </a>
                        {% endif %}
                        {% if status == 'inactive' and canReactivate %}
                        <form method="post" action="/clients/{{ client.id }}/reactivate" class="d-inline reactivate-form"
                              data-confirm-title="Reactivate Client"
                              data-confirm-message="Reactivate client <strong>{{ client.code }}</strong>?">
                            {{ csrf.token(csrfToken) }}
                            <button type="submit" class="btn btn-sm btn-outline-success" aria-label="Reactivate {{ client.code }}">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                        </form>
                        {% endif %}
                        {% if canUpgrade and client.type == 'CASUAL' and status != 'inactive' %}
                        <button type="button" class="btn btn-sm btn-outline-info"
                                aria-label="Upgrade {{ client.code }} to Member"
                                data-bs-toggle="modal" data-bs-target="#upgradeModal{{ client.id }}"
                                data-client-code="{{ client.code }}"
                                data-client-name="{{ client.fullName }}">
                            <i class="bi bi-person-up"></i>
                        </button>
                        {% endif %}
                        {% if canDelete and status != 'inactive' %}
                        <form method="post" action="/clients/{{ client.id }}/delete" class="d-inline delete-form"
                              data-confirm-title="Delete Client"
                              data-confirm-message="Delete client <strong>{{ client.code }}</strong>? This action can be undone.">
                            {{ csrf.token(csrfToken) }}
                            <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Delete {{ client.code }}">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}

{% for client in clients %}
{% if canUpgrade and client.type == 'CASUAL' and status != 'inactive' %}
<div class="modal fade" id="upgradeModal{{ client.id }}" tabindex="-1" aria-labelledby="upgradeModalLabel{{ client.id }}" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" action="/clients/{{ client.id }}/upgrade" class="modal-content bg-dark text-light border-secondary">
            {{ csrf.token(csrfToken) }}
            <div class="modal-header">
                <h5 class="modal-title" id="upgradeModalLabel{{ client.id }}"><i class="bi bi-person-up"></i> Upgrade to Member</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Upgrade client <strong>{{ client.code }}</strong> to MEMBER status.</p>

                <div class="mb-3">
                    <label class="form-label small">Payment Period</label>
                    <div class="d-flex gap-3">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input period-radio" type="radio" name="months" id="periodYear{{ client.id }}" value="12" checked>
                            <label class="form-check-label" for="periodYear{{ client.id }}">
                                1 Year — {{ currency }} {{ membershipFeeYearly }}
                            </label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input period-radio" type="radio" name="months" id="periodMonth{{ client.id }}" value="1">
                            <label class="form-check-label" for="periodMonth{{ client.id }}">
                                1 Month — {{ currency }} {{ membershipFeeMonthly }}
                            </label>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small">Payment Method</label>
                    <select class="form-select form-select-sm bg-dark border-secondary text-light" name="paymentMethod" id="paymentMethod{{ client.id }}">
                        <option value="CASH">Cash</option>
                        <option value="CARD">Card</option>
                        <option value="TRANSFER">Bank Transfer</option>
                    </select>
                </div>

                <div class="alert alert-warning bg-dark border-secondary text-warning small mb-2">
                    <i class="bi bi-info-circle"></i>
                    You are about to upgrade client <strong>{{ client.code }}</strong> to MEMBER.
                    Verify the payment has been received before proceeding.
                </div>

                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="paymentConfirmed" id="paymentConfirmed{{ client.id }}" value="true" required>
                    <label class="form-check-label" for="paymentConfirmed{{ client.id }}">
                        I confirm the payment has been received
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-sm btn-info text-dark fw-bold">Confirm Payment &amp; Upgrade</button>
            </div>
        </form>
    </div>
</div>
{% endif %}
{% endfor %}
{% endblock %}

{% block scripts %}
<script src="/js/iam.js" nonce="{{ securityNonce }}"></script>
<script src="/js/books.js" nonce="{{ securityNonce }}"></script>
{% endblock %}
