{%- extends "layout" -%}

{% block title %}Client - Library{% endblock %}

{% block content %}
{% import "_macros/csrf" as csrf %}
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="mb-0">Client: {{ client.code }}</h1>
        <p class="text-muted">Client details and membership information.</p>
    </div>
    <div>
        {% if canUpdate %}
        <a href="/clients/{{ client.id }}/edit" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-pencil"></i> Edit
        </a>
        {% endif %}
    </div>
</div>

<div class="card bg-dark border-secondary mt-3">
    <div class="card-body">
        <table class="table table-borderless text-light">
            <tbody>
                <tr>
                    <th>Code</th><td>{{ client.code }}</td>
                    <th>DNI</th><td>{{ client.dni }}</td>
                </tr>
                <tr>
                    <th>Full Name</th><td>{{ client.fullName }}</td>
                    <th>Email</th><td>{{ client.email | default("N/A") }}</td>
                </tr>
                <tr>
                    <th>Phone</th><td>{{ client.phone | default("N/A") }}</td>
                    <th>Address</th><td>{{ client.address | default("N/A") }}</td>
                </tr>
                <tr>
                    <th>Type</th>
                    <td>
                        <span class="badge {% if client.type == 'MEMBER' %}bg-info{% else %}bg-secondary{% endif %}">
                            {{ client.typeLabel }}
                        </span>
                    </td>
                    <th>Status</th><td>{{ client.statusLabel }}</td>
                </tr>
                <tr>
                    <th>Member Since</th><td>{{ client.memberSince | default("N/A") }}</td>
                    <th>Member Until</th><td>{{ client.memberUntil | default("N/A") }}</td>
                </tr>
                <tr>
                    <th>Birth Date</th><td>{{ client.birthDate | default("N/A") }}</td>
                    <th>Created</th><td>{{ client.createdAt }}</td>
                </tr>
                <tr>
                    <th>Updated</th><td>{{ client.updatedAt }}</td><td></td>
                </tr>
                {% if client.notes %}
                <tr>
                    <th>Notes</th><td colspan="3">{{ client.notes }}</td>
                </tr>
                {% endif %}
            </tbody>
        </table>
    </div>
</div>

{% if benefits is not null %}
<div class="card bg-dark border-secondary mt-3">
    <div class="card-header text-light">
        <i class="bi bi-star"></i> Membership Benefits ({{ benefits.clientTypeLabel }})
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <div class="text-center p-3">
                    <h3 class="text-primary">{{ benefits.maxLoanDays }}</h3>
                    <p class="text-muted mb-0">Max Loan Days</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="text-center p-3">
                    <h3 class="text-primary">{{ benefits.maxActiveReservations }}</h3>
                    <p class="text-muted mb-0">Active Reservations</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="text-center p-3">
                    <h3 class="text-primary">{{ benefits.maxRenewals }}</h3>
                    <p class="text-muted mb-0">Max Renewals</p>
                </div>
            </div>
        </div>
        <table class="table table-borderless text-light mt-3">
            <tbody>
                <tr>
                    <th>Renewal Max Days</th><td>{{ benefits.renewalMaxDays }} days</td>
                    <th>Renewal Max Times</th><td>{{ benefits.renewalMaxTimes }}</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
{% endif %}

<div class="mt-4">
    <a href="/clients" class="btn btn-outline-secondary">Back to List</a>
</div>
{% endblock %}

{% block scripts %}
<script src="/js/iam.js" nonce="{{ securityNonce }}"></script>
<script src="/js/books.js" nonce="{{ securityNonce }}"></script>
{% endblock %}
