{#- =========================================================================
     _partials/flash.peb
     Renders flash messages injected by the renderer.
     Each message is a map with keys: type, title, message.
     Types: success, danger, warning, info
     ========================================================================= -#}
{% if flashMessages is not empty %}
{% for msg in flashMessages %}
{% set iconMap = {
    'success': 'bi-check-circle',
    'danger': 'bi-x-circle',
    'warning': 'bi-exclamation-triangle',
    'info': 'bi-info-circle'
} %}
{% set icon = iconMap[msg.type] | default('bi-info-circle') %}
<div class="toast" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="5000">
    <div class="toast-header bg-{{ msg.type | default('info') }} text-white">
        <i class="bi {{ icon }} me-2"></i>
        <strong class="me-auto">{{ msg.title | default('Notification') }}</strong>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
    <div class="toast-body">
        {{ msg.message }}
    </div>
</div>
{% endfor %}
{% endif %}
