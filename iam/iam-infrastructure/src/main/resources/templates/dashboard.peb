{#- =========================================================================
    dashboard.peb
    Dashboard page. Extends the base layout (which includes the dynamic
    sidebar built from the user's permissions).
    ========================================================================= -#}
{% extends "layout" %}

{% block title %}Dashboard - Library{% endblock %}

{% block content %}
<div class="page-header">
    <h1>Welcome, {{ user.fullName }}!</h1>
    <p class="text-muted">This is your dashboard.</p>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card stat-card bg-dark border-secondary text-light">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="stat-icon bg-primary-subtle text-primary">
                        <i class="bi bi-people"></i>
                    </div>
                    <div class="ms-3">
                        <div class="small text-muted">Role</div>
                        <div class="h5 mb-0">{{ user.role.name }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card bg-dark border-secondary text-light">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="stat-icon bg-success-subtle text-success">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div class="ms-3">
                        <div class="small text-muted">Permissions</div>
                        <div class="h5 mb-0">{{ user.role.permissions | length }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card bg-dark border-secondary text-light">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="stat-icon bg-info-subtle text-info">
                        <i class="bi bi-envelope"></i>
                    </div>
                    <div class="ms-3">
                        <div class="small text-muted">Email</div>
                        <div class="h5 mb-0 text-truncate">{{ user.email }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mt-4 bg-dark border-secondary">
    <div class="card-header bg-dark border-secondary text-light">
        <i class="bi bi-grid-3x3-gap"></i> Your Modules
    </div>
    <div class="card-body bg-dark">
        <div class="row g-3">
            {% for section in navSections %}
            <div class="col-md-4">
                <div class="card h-100 module-card bg-dark border-secondary text-light">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="bi {{ section.icon }}"></i>
                            {{ section.menuLabel }}
                        </h5>
                        <ul class="list-unstyled mb-0">
                            {% for item in section.items %}
                            <li>
                                <a href="{{ item.url }}" class="text-info text-decoration-none">
                                    <i class="bi {{ item.icon }}"></i>
                                    {{ item.label }}
                                </a>
                            </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
