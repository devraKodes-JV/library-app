{#- =========================================================================
     error.peb
     Generic error page for authenticated users.
     Extends the layout and shows the error message with a back button.
     ========================================================================= -#}
{% extends "layout" %}

{% block title %}Error - Library{% endblock %}

{% block content %}
<div class="page-header">
    <h1 class="mb-0 text-danger">
        <i class="bi bi-exclamation-octagon"></i>
        {{ errorTitle | default('Unexpected Error') }}
    </h1>
    <p class="text-muted">{{ errorMessage | default('An unexpected error occurred.') }}</p>
</div>

<div class="card mt-3 bg-dark border-secondary">
    <div class="card-body bg-dark text-light">
        <p class="mb-3">Please try again or go back to the previous page.</p>
        <button type="button" class="btn btn-primary" onclick="history.back()">
            <i class="bi bi-arrow-left"></i> Go Back
        </button>
        <a href="/" class="btn btn-outline-secondary">Go to Dashboard</a>
    </div>
</div>
{% endblock %}
