{%- extends "layout" -%}

{% block title %}{% if mode == 'edit' %}Edit Role{% else %}New Role{% endif %} - Library{% endblock %}

{% block content %}
<div class="page-header">
    <h1 class="mb-0">
        {% if mode == 'edit' %}Edit Role{% else %}New Role{% endif %}
    </h1>
    <p class="text-muted">Permissions are assigned by module. Modules and
        permissions themselves are defined by the development team and are
        managed via migrations, not here.</p>
</div>

<form method="post"
      action="{% if mode == 'edit' %}/iam/roles/{{ role.id }}{% else %}/iam/roles{% endif %}"
      class="text-light">
    {% import "_macros/csrf" as csrf %}
    {{ csrf.token(csrfToken) }}
    <div class="card mt-3 bg-dark border-secondary">
        <div class="card-body bg-dark">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="name">Name</label>
                    <input type="text" id="name" name="name" class="form-control bg-dark border-secondary text-light" required
                           value="{% if role is not null %}{{ role.name }}{% endif %}">
                    {% if nameError is defined %}
                    <div class="text-danger small mt-1">{{ nameError }}</div>
                    {% endif %}
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="description">Description</label>
                    <input type="text" id="description" name="description" class="form-control bg-dark border-secondary text-light"
                           value="{% if role is not null %}{{ role.description }}{% endif %}">
                    {% if descriptionError is defined %}
                    <div class="text-danger small mt-1">{{ descriptionError }}</div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

<div class="card mt-3 bg-dark border-secondary">
        <div class="card-header bg-dark border-secondary text-light d-flex justify-content-between align-items-center flex-wrap gap-2"
             id="permissionFilterForm">
            <div class="d-flex align-items-center">
                <i class="bi bi-shield-lock me-1"></i> Permissions by module
            </div>
            <div class="d-flex gap-2">
                <select id="filterModule" class="form-select form-select-sm w-auto bg-dark border-secondary text-light">
                    <option value="">All modules</option>
                    {% for group in permissionGroups %}
                    <option value="{{ group.module.code }}">{{ group.module.menuLabel | default(group.module.name) }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>
        <div class="card-body bg-dark">
            {% if permissionGroups is empty %}
            <p class="text-muted mb-0">No permissions are defined.</p>
            {% else %}
            <div class="table-responsive container">
                <table class="table table-hover align-middle mb-0 data-table text-light" id="permissionsTable">
                    <thead>
                        <tr>
                            <th style="width: 40px;"><input class="form-check-input bg-dark border-secondary" type="checkbox" id="selectAllPermissions"></th>
                            <th>Permission</th>
                            <th>Code</th>
                            <th>Module</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for group in permissionGroups %}
                            {% for perm in group.items %}
                            <tr data-module="{{ group.module.code }}">
                                <td>
                                    <input class="form-check-input bg-dark border-secondary permission-checkbox" type="checkbox"
                                           name="permissionIds" value="{{ perm.id }}"
                                           id="perm-{{ perm.id }}"
                                           {% if selectedPermissionIds contains perm.id %}checked{% endif %}>
                                </td>
                                <td>{{ perm.menuLabel | default(perm.name) }}</td>
                                <td><span class="text-muted small font-monospace">{{ perm.code }}</span></td>
                                <td>
                                    <span class="badge bg-secondary">{{ group.module.menuLabel | default(group.module.name) }}</span>
                                    <span class="d-none">{{ group.module.code }}</span>
                                </td>
                            </tr>
                            {% endfor %}
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg"></i> Save
        </button>
        <a href="/iam/roles" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
{% endblock %}

{% block scripts %}
<script src="/js/iam.js"></script>
{% endblock %}
