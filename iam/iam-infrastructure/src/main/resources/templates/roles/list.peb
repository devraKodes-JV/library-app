{%- extends "layout" -%}

{% block title %}Roles - Library{% endblock %}

{% block content %}
{% import "_macros/csrf" as csrf %}
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="mb-0">Roles</h1>
        <p class="text-muted">Manage roles and their permissions.</p>
    </div>
    {% if canCreate %}
    <a href="/iam/roles/new" class="btn btn-primary text-white">
        <i class="bi bi-plus-lg"></i> New Role
    </a>
    {% endif %}
</div>

{% if roles is empty %}
<div class="alert alert-info bg-dark border-secondary text-light">No roles found.</div>
{% else %}
<div class="card mt-3 bg-dark border-secondary">
    <div class="table-responsive container">
        <table class="table table-hover align-middle mb-0 data-table text-light">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Permissions</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for role in roles %}
                <tr>
                    <td>
                        <span class="badge bg-primary">{{ role.name }}</span>
                    </td>
                    <td class="text-muted">{{ role.description }}</td>
                    <td>
                        {% if role.permissions is empty %}
                        <span class="text-muted">No permissions</span>
                        {% else %}
                        <span class="badge bg-light text-dark">{{ role.permissions | length }} permissions</span>
                        {% endif %}
                    </td>
                    <td class="text-end">
                        {% if canUpdate %}
                        <a href="/iam/roles/{{ role.id }}/edit" class="btn btn-sm btn-outline-secondary" aria-label="Edit {{ role.name }}">
                            <i class="bi bi-pencil"></i>
                        </a>
                        {% endif %}
                        {% if canDelete %}
                        <form method="post" action="/iam/roles/{{ role.id }}/delete" class="d-inline delete-form"
                              data-confirm-title="Delete Role"
                              data-confirm-message="Delete role <strong>{{ role.name }}</strong>? This action can be undone by reinstating the role.">
                            {{ csrf.token(csrfToken) }}
                            <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Delete {{ role.name }}">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}

<!-- Real-time notification stream (SSE) destination for this page. -->
<div class="toast-container position-fixed top-0 end-0 p-3" id="notificationToast"></div>
{% endblock %}

{% block scripts %}
<script src="/js/iam.js" nonce="{{ securityNonce }}"></script>
{% endblock %}
