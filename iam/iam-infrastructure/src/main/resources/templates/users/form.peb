{%- extends "layout" -%}

{% block title %}{% if mode == 'edit' %}Edit User{% else %}New User{% endif %} - Library{% endblock %}

{% block content %}
<div class="page-header">
    <h1 class="mb-0">
        {% if mode == 'edit' %}Edit User{% else %}New User{% endif %}
    </h1>
    <p class="text-muted">Assign a role and manage the account status.</p>
</div>

<form method="post"
      action="{% if mode == 'edit' %}/iam/users/{{ userForm.id }}{% else %}/iam/users{% endif %}"
      class="text-light">
    {% import "_macros/csrf" as csrf %}
    {{ csrf.token(csrfToken) }}
    <div class="card mt-3 bg-dark border-secondary">
        <div class="card-body bg-dark">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="username">Username</label>
                    {% if mode == 'edit' %}
                    <input type="text" id="username" class="form-control bg-dark border-secondary text-light" value="{{ userForm.username }}" disabled>
                    {% else %}
                    <input type="text" id="username" name="username" class="form-control bg-dark border-secondary text-light" required
                           value="{% if userForm is not null %}{{ userForm.username }}{% endif %}">
                    {% if usernameError is defined %}
                    <div class="text-danger small mt-1">{{ usernameError }}</div>
                    {% endif %}
                    {% endif %}
                </div>
                <div class="col-md-6">
                    {% if mode == 'edit' %}
                    <label class="form-label">Password</label>
                    <input type="password" class="form-control bg-dark border-secondary text-light" value="(unchanged)" disabled>
                    {% else %}
                    <label class="form-label" for="password">Password</label>
                    <input type="password" id="password" name="password" class="form-control bg-dark border-secondary text-light" required>
                    {% if passwordError is defined %}
                    <div class="text-danger small mt-1">{{ passwordError }}</div>
                    {% endif %}
                    {% endif %}
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="fullName">Full Name</label>
                    <input type="text" id="fullName" name="fullName" class="form-control bg-dark border-secondary text-light"
                           value="{% if userForm is not null %}{{ userForm.fullName }}{% endif %}">
                    {% if fullNameError is defined %}
                    <div class="text-danger small mt-1">{{ fullNameError }}</div>
                    {% endif %}
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="email">Email</label>
                    <input type="email" id="email" name="email" class="form-control bg-dark border-secondary text-light"
                           value="{% if userForm is not null %}{{ userForm.email }}{% endif %}">
                    {% if emailError is defined %}
                    <div class="text-danger small mt-1">{{ emailError }}</div>
                    {% endif %}
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="roleName">Role</label>
                    <select id="roleName" name="roleName" class="form-select bg-dark border-secondary text-light" required>
                        {% for role in roles %}
                        <option value="{{ role.name }}"
                                {% if userForm is not null and userForm.role is not null and userForm.role.name == role.name %}selected{% endif %}>
                            {{ role.name }}
                        </option>
                        {% endfor %}
                    </select>
                    {% if roleError is defined %}
                    <div class="text-danger small mt-1">{{ roleError }}</div>
                    {% endif %}
                </div>
                <div class="col-md-6">
                    <div class="form-check mt-4">
                        <input class="form-check-input bg-dark border-secondary" type="checkbox" id="enabled" name="enabled"
                               {% if userForm is null or userForm.enabled %}checked{% endif %}>
                        <label class="form-check-label text-light" for="enabled">Enabled</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg"></i> Save
        </button>
        <a href="/iam/users" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
{% endblock %}
