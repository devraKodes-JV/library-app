{%- extends "layout" -%}

{% block title %}Users - Library{% endblock %}

{% block content %}
{% import "_macros/csrf" as csrf %}
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="mb-0">Users</h1>
        <p class="text-muted">Manage user accounts and their roles.</p>
    </div>
    {% if canCreate %}
    <a href="/iam/users/new" class="btn btn-primary text-white">
        <i class="bi bi-plus-lg"></i> New User
    </a>
    {% endif %}
</div>

<!-- Active users -->
<div class="card mt-3 bg-dark border-secondary">
    <div class="card-header bg-dark border-secondary text-light">
        <i class="bi bi-people"></i> Active Users
    </div>
    <div class="table-responsive container">
        <table class="table table-hover align-middle mb-0 data-table text-light">
            <thead>
            <tr>
                <th>Username</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for u in activeUsers %}
            <tr>
                <td><strong>{{ u.username }}</strong></td>
                <td>{{ u.fullName }}</td>
                <td>{{ u.email }}</td>
                <td><span class="badge bg-primary">{{ u.role.name }}</span></td>
                <td>
                    {% if u.enabled %}
                    <span class="badge bg-success">Active</span>
                    {% else %}
                    <span class="badge bg-warning text-dark">Disabled</span>
                    {% endif %}
                </td>
                <td class="text-end">
                    {% if canUpdate %}
                    <a href="/iam/users/{{ u.id }}/edit" class="btn btn-sm btn-outline-secondary"
                       aria-label="Edit {{ u.username }}">
                        <i class="bi bi-pencil"></i>
                    </a>
                    {% endif %}
                    {% if canDelete %}
                    <form method="post" action="/iam/users/{{ u.id }}/delete" class="d-inline delete-form"
                          data-confirm-title="Delete User"
                          data-confirm-message="Delete user <strong>{{ u.username }}</strong>? This action can be undone by reinstating the user.">
                        {{ csrf.token(csrfToken) }}
                        <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Delete {{ u.username }}">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
            {% if activeUsers is empty %}
            <tr class="d-none"></tr>
            {% endif %}
            </tbody>
        </table>
    </div>
</div>

<!-- Inactive (disabled / deleted) users section -->
{% if canReinstate %}
<div class="card mt-4 bg-dark border-secondary">
    <div class="card-header bg-dark border-secondary text-light">
        <i class="bi bi-person-dash"></i> Inactive Accounts
    </div>
    <div class="table-responsive container">
        <table class="table table-hover align-middle mb-0 data-table text-light">
            <thead>
            <tr>
                <th>Username</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Reason</th>
                <th class="text-end">Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for u in inactiveUsers %}
            <tr>
                <td><strong>{{ u.username }}</strong></td>
                <td>{{ u.fullName }}</td>
                <td>{{ u.email }}</td>
                <td><span class="badge bg-secondary">{{ u.role.name }}</span></td>
                <td>
                    {% if u.isDeleted %}
                    <span class="badge bg-danger">Deleted</span>
                    {% else %}
                    <span class="badge bg-warning text-dark">Disabled</span>
                    {% endif %}
                </td>
                <td class="text-end">
                    <form method="post" action="/iam/users/{{ u.id }}/reinstate" class="d-inline delete-form"
                          data-confirm-title="Reinstate User"
                          data-confirm-message="Reinstate user <strong>{{ u.username }}</strong>?">
                        {{ csrf.token(csrfToken) }}
                        <button type="submit" class="btn btn-sm btn-outline-success" aria-label="Reinstate {{ u.username }}">
                            <i class="bi bi-arrow-counterclockwise"></i> Reinstate
                        </button>
                    </form>
                </td>
            </tr>
            {% endfor %}
            {% if inactiveUsers is empty %}
            <tr class="d-none"></tr>
            {% endif %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}
{% endblock %}

{% block scripts %}
<script src="/js/iam.js" nonce="{{ securityNonce }}"></script>
{% endblock %}
