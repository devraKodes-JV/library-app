{%- extends "layout" -%}

{% block title %}Reservation Successful{% endblock %}

{% block content %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="mb-4">
                <i class="bi bi-check-circle text-success" style="font-size: 4rem;"></i>
            </div>
            <h2 class="text-light mb-3">Reservation Confirmed</h2>
            <p class="text-muted mb-4">Your reservation has been created successfully. Please come to the library within 3 days to pick up your book.</p>
            <a href="/catalog" class="btn btn-primary">Back to Catalog</a>
        </div>
    </div>
</div>
{% endblock %}
