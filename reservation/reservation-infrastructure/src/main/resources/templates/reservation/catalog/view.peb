{%- extends "layout" -%}

{% block title %}Library Catalog{% endblock %}

{% block content %}
<div class="catalog-header">
    <div class="container">
        <a href="/" class="back-link"><i class="bi bi-arrow-left"></i> Back</a>
        <h1 class="catalog-title"><i class="bi bi-book"></i> Book Catalog</h1>
        <p class="text-muted mb-0">Browse available books and make a reservation</p>
    </div>
</div>

<div class="container pb-5">
    {% if catalogItems is empty %}
    <div class="alert alert-info bg-dark border-secondary text-light">
        <i class="bi bi-info-circle"></i> No books available at the moment.
    </div>
    {% else %}
    <div class="row">
        {% for item in catalogItems %}
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card catalog-card bg-dark border-secondary h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title text-light">{{ item.title }}</h5>
                    <p class="card-text text-muted mb-2">
                        <i class="bi bi-bookmark"></i> Edition: {{ item.editionNumber }}
                    </p>
                    {% if item.publisher %}
                    <p class="card-text text-muted mb-3">
                        <i class="bi bi-building"></i> {{ item.publisher }}
                    </p>
                    {% endif %}
                    <div class="mt-auto d-flex justify-content-between align-items-center">
                        <span class="badge {% if item.available > 0 %}bg-success{% else %}bg-danger{% endif %} bg-opacity-25 {% if item.available > 0 %}text-success{% else %}text-danger{% endif %}">
                            <i class="bi bi-{% if item.available > 0 %}check-circle{% else %}x-circle{% endif %}"></i>
                            {{ item.available }} available
                        </span>
                        <a href="/catalog/reserve/{{ item.id }}" class="btn btn-sm {% if item.available > 0 %}btn-primary{% else %}btn-secondary disabled{% endif %}">
                            <i class="bi bi-calendar-check"></i> Reserve
                        </a>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}
</div>
{% endblock %}

{% block styles %}
<style>
    .catalog-header {
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(139, 92, 246, 0.1) 100%);
        padding: 2rem 0;
        margin-bottom: 2rem;
        border-bottom: 1px solid rgba(255,255,255,0.1);
    }
    .catalog-title { font-size: 2rem; font-weight: 700; color: #fff; }
    .back-link {
        color: #94a3b8;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1rem;
        transition: color 0.2s;
    }
    .back-link:hover { color: #fff; }
    .catalog-card {
        transition: all 0.3s ease;
        border: 1px solid rgba(255,255,255,0.1);
    }
    .catalog-card:hover {
        transform: translateY(-4px);
        border-color: rgba(59, 130, 246, 0.5);
        box-shadow: 0 10px 30px rgba(59, 130, 246, 0.2);
    }
</style>
{% endblock %}
