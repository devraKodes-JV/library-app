{%- extends "layout" -%}

{% block title %}
    {% if mode == 'create' %}New Reservation{% else %}Edit Reservation{% endif %}
{% endblock %}

{% block content %}
{% import "_macros/csrf" as csrf %}
<div class="page-header">
    <h1 class="mb-0">{% if mode == 'create' %}New Reservation{% else %}Edit Reservation{% endif %}</h1>
</div>

<form method="post" action="{% if mode == 'create' %}/reservations{% else %}/reservations/{{ reservation.id }}{% endif %}">
    {{ csrf.token(csrfToken) }}

    <div class="card bg-dark border-secondary mt-3">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="clientId" class="form-label">Client *</label>
                    <select class="form-select bg-dark border-secondary text-light" id="clientId" name="clientId" required>
                        <option value="">Select client...</option>
                        {% for client in clients %}
                        <option value="{{ client.id }}">{{ client.fullName }} ({{ client.dni }})</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="stockItemId" class="form-label">Stock Item *</label>
                    <select class="form-select bg-dark border-secondary text-light" id="stockItemId" name="stockItemId" required>
                        <option value="">Select stock item...</option>
                        {% for item in stockItems %}
                        <option value="{{ item.id }}">{{ item.code }} - {{ item.editionName }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="loanDays" class="form-label">Loan Days *</label>
                    <input type="number" class="form-control bg-dark border-secondary text-light" id="loanDays" name="loanDays" value="7" min="1" max="30" required>
                    <div class="form-text text-muted">Number of days the client will borrow the item</div>
                </div>
            </div>
            <div class="mb-3">
                <label for="notes" class="form-label">Notes</label>
                <textarea class="form-control bg-dark border-secondary text-light" id="notes" name="notes" rows="2"></textarea>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">{% if mode == 'create' %}Create{% else %}Save{% endif %}</button>
        <a href="/reservations" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
{% endblock %}
