<?xml version="1.0" encoding="UTF-8"?>
<!-- security-domain: pure business rules with zero framework dependencies. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Inherits from the security feature aggregator. -->
    <parent>
        <groupId>com.library</groupId>
        <artifactId>security</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>security-domain</artifactId>
    <name>Security Domain</name>
    <description>
        Pure domain layer of the Security feature. Contains the security models
        (SecurityAuditEvent) and the ports (in/out) that define
        the contracts of the feature. This module has NO framework or
        infrastructure dependency: it only uses the JDK.
    </description>

    <dependencies>
        <!-- JUnit 5 for domain unit tests (optional, test scope only). -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
