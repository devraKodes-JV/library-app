{%- extends "layout" -%}

{% block title %}Stock Items - Library{% endblock %}

{% block content %}
{% import "_macros/csrf" as csrf %}
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="mb-0">Stock Items</h1>
        <p class="text-muted">Manage physical copies of editions.</p>
    </div>
    {% if canCreate %}
    <a href="/stock/items/new" class="btn btn-primary text-white">
        <i class="bi bi-plus-lg"></i> New Stock Item
    </a>
    {% endif %}
</div>

<div class="d-flex gap-2 mb-3">
    <a href="?status=active" class="btn btn-sm {% if status == 'active' %}btn-primary{% else %}btn-outline-secondary{% endif %}">Active</a>
    <a href="?status=inactive" class="btn btn-sm {% if status == 'inactive' %}btn-primary{% else %}btn-outline-secondary{% endif %}">Inactive</a>
    <a href="?status=all" class="btn btn-sm {% if status == 'all' %}btn-primary{% else %}btn-outline-secondary{% endif %}">All</a>
</div>

{% if items is empty %}
<div class="alert alert-info bg-dark border-secondary text-light">No stock items found.</div>
{% else %}
<div class="card mt-3 bg-dark border-secondary">
    <div class="table-responsive container">
        <table class="table table-hover align-middle mb-0 data-table text-light">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Edition</th>
                    <th>Location</th>
                    <th>State</th>
                    <th>Condition</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                <tr>
                    <td><strong>{{ item.code }}</strong></td>
                    <td class="text-muted">{{ item.editionName }}</td>
                    <td class="text-muted">{{ item.locationName }}</td>
                    <td>{{ item.stateLabel }}</td>
                    <td>{{ item.conditionLabel }}</td>
                    <td class="text-end">
                        {% if canUpdate and status != 'inactive' %}
                        <a href="/stock/items/{{ item.id }}/edit" class="btn btn-sm btn-outline-secondary" aria-label="Edit {{ item.code }}">
                            <i class="bi bi-pencil"></i>
                        </a>
                        {% endif %}
                        {% if status == 'inactive' and canReactivate %}
                        <form method="post" action="/stock/items/{{ item.id }}/reactivate" class="d-inline reactivate-form"
                              data-confirm-title="Reactivate Stock Item"
                              data-confirm-message="Reactivate stock item <strong>{{ item.code }}</strong>?">
                            {{ csrf.token(csrfToken) }}
                            <button type="submit" class="btn btn-sm btn-outline-success" aria-label="Reactivate {{ item.code }}">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                        </form>
                        {% endif %}
                        {% if canDelete and status != 'inactive' %}
                        <form method="post" action="/stock/items/{{ item.id }}/delete" class="d-inline delete-form"
                              data-confirm-title="Delete Stock Item"
                              data-confirm-message="Delete stock item <strong>{{ item.code }}</strong>? This action can be undone.">
                            {{ csrf.token(csrfToken) }}
                            <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Delete {{ item.code }}">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}
{% endblock %}

{% block scripts %}
<script src="/js/iam.js" nonce="{{ securityNonce }}"></script>
<script src="/js/books.js" nonce="{{ securityNonce }}"></script>
{% endblock %}
