{%- extends "layout" -%}

{% block title %}Stock Locations - Library{% endblock %}

{% block content %}
{% import "_macros/csrf" as csrf %}
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="mb-0">Stock Locations</h1>
        <p class="text-muted">Manage physical storage locations (shelves/sections).</p>
    </div>
    {% if canCreate %}
    <a href="/stock/locations/new" class="btn btn-primary text-white">
        <i class="bi bi-plus-lg"></i> New Location
    </a>
    {% endif %}
</div>

<div class="d-flex gap-2 mb-3">
    <a href="?status=active" class="btn btn-sm {% if status == 'active' %}btn-primary{% else %}btn-outline-secondary{% endif %}">Active</a>
    <a href="?status=inactive" class="btn btn-sm {% if status == 'inactive' %}btn-primary{% else %}btn-outline-secondary{% endif %}">Inactive</a>
    <a href="?status=all" class="btn btn-sm {% if status == 'all' %}btn-primary{% else %}btn-outline-secondary{% endif %}">All</a>
</div>

{% if locations is empty %}
<div class="alert alert-info bg-dark border-secondary text-light">No stock locations found.</div>
{% else %}
<div class="card mt-3 bg-dark border-secondary">
    <div class="table-responsive container">
        <table class="table table-hover align-middle mb-0 data-table text-light">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Capacity</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for loc in locations %}
                <tr>
                    <td><strong>{{ loc.code }}</strong></td>
                    <td>{{ loc.name }}</td>
                    <td class="text-muted">{{ loc.description | default("N/A") }}</td>
                    <td class="text-muted">{{ loc.capacity | default("Unlimited") }}</td>
                    <td class="text-end">
                        {% if canUpdate and status != 'inactive' %}
                        <a href="/stock/locations/{{ loc.id }}/edit" class="btn btn-sm btn-outline-secondary" aria-label="Edit {{ loc.name }}">
                            <i class="bi bi-pencil"></i>
                        </a>
                        {% endif %}
                        {% if status == 'inactive' and canReactivate %}
                        <form method="post" action="/stock/locations/{{ loc.id }}/reactivate" class="d-inline reactivate-form"
                              data-confirm-title="Reactivate Location"
                              data-confirm-message="Reactivate location <strong>{{ loc.name }}</strong>?">
                            {{ csrf.token(csrfToken) }}
                            <button type="submit" class="btn btn-sm btn-outline-success" aria-label="Reactivate {{ loc.name }}">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                        </form>
                        {% endif %}
                        {% if canDelete and status != 'inactive' %}
                        <form method="post" action="/stock/locations/{{ loc.id }}/delete" class="d-inline delete-form"
                              data-confirm-title="Delete Location"
                              data-confirm-message="Delete location <strong>{{ loc.code }} - {{ loc.name }}</strong>? This action can be undone.">
                            {{ csrf.token(csrfToken) }}
                            <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Delete {{ loc.name }}">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}
{% endblock %}

{% block scripts %}
<script src="/js/iam.js" nonce="{{ securityNonce }}"></script>
<script src="/js/books.js" nonce="{{ securityNonce }}"></script>
{% endblock %}
