{%- extends "layout" -%}

{% block title %}Stock Movements - Library{% endblock %}

{% block content %}
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="mb-0">Stock Movements</h1>
        <p class="text-muted">Record of all stock item transfers, entries and exits.</p>
    </div>
    <a href="/stock/items" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-box-seam"></i> Stock Items
    </a>
</div>

{% if movements is empty %}
<div class="alert alert-info bg-dark border-secondary text-light">No stock movements recorded.</div>
{% else %}
<div class="card mt-3 bg-dark border-secondary">
    <div class="table-responsive container">
        <table class="table table-hover align-middle mb-0 data-table text-light">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Type</th>
                    <th>Stock Item</th>
                    <th>From</th>
                    <th>To</th>
                    <th>Reason</th>
                    <th>Created</th>
                    <th>By</th>
                </tr>
            </thead>
            <tbody>
                {% for m in movements %}
                <tr>
                    <td>{{ m.id }}</td>
                    <td>{{ m.typeLabel }}</td>
                    <td><strong>{{ m.stockItemId }}</strong></td>
                    <td class="text-muted">{% if m.sourceLocationId %}{{ m.sourceLocationId }}{% else %}—{% endif %}</td>
                    <td class="text-muted">{% if m.targetLocationId %}{{ m.targetLocationId }}{% else %}—{% endif %}</td>
                    <td class="text-muted">{{ m.reason }}</td>
                    <td class="text-muted small">{{ m.createdAt }}</td>
                    <td class="text-muted small">{{ m.createdBy }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}
{% endblock %}
